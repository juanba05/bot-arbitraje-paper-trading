# ============================================================
# .gitignore — Archivos que NUNCA se suben a GitHub
# ============================================================

# CREDENCIALES — lo mas importante
.env
*.env
secrets.py

# Base de datos (datos personales y operaciones)
datos/
*.db
*.sqlite

# Logs
logs/
*.log

# Archivos de configuracion del dashboard (pueden tener datos sensibles)
datos/dashboard_config.json
datos/bot_activo.json
datos/alertas_*.json
datos/ratios_comafi.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Entornos virtuales
venv/
env/
.venv/

# IDEs
.vscode/
.idea/
*.suo
*.user

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Excel de ratios (datos propios)
ratios_comafi.xlsx
